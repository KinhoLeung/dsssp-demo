{
  "name": "dsssp-demo",
  "type": "module",
  "main": "electron/main.cjs",
  "private": false,
  "version": "0.6.3",
  "author": "Oleksiy Strelets",
  "license": "AGPL-3.0-only",
  "homepage": "https://dsssp.io",
  "description": "Demo Project of the DSSSP: React Library of Audio Processing and Visualization",
  "funding": "https://github.com/numberonebot/dsssp?sponsor=1",
  "bugs": {
    "url": "https://github.com/numberonebot/dsssp-demo/issues"
  },
  "keywords": [
    "react",
    "react-components",
    "ui-library",
    "svg",
    "chart",
    "graph",
    "visualization",
    "dsp",
    "signal-processing",
    "digital-signal-processing",
    "web-audio",
    "audio",
    "sound",
    "filters",
    "effects",
    "spectrum",
    "waveform",
    "processing",
    "engineering"
  ],
  "scripts": {
    "proto:gen": "node ./node_modules/protobufjs-cli/bin/pbjs -t static-module -w es6 -o src/device/proto/generated/webhmi.js webhmi.proto && node ./node_modules/protobufjs-cli/bin/pbts -o src/device/proto/generated/webhmi.d.ts src/device/proto/generated/webhmi.js && node scripts/mark-generated.mjs",
    "predev": "npm run proto:gen",
    "prebuild": "npm run proto:gen",
    "prelint": "npm run proto:gen",
    "dev": "vite",
    "build": "vite build",
    "build:github": "vite build --mode github",
    "build:landing": "vite build --mode landing",
    "preview": "vite preview --mode github",
    "dev:app": "concurrently \"vite\" \"wait-on tcp:3003 && electron .\"",
    "build:app": "vite build --base=./ && electron-builder",
    "deps": "npx taze",
    "deps:update": "npx taze -w",
    "deploy:github": "gh-pages -d dist",
    "test": "node scripts/test-runner.mjs",
    "test:watch": "node scripts/test-runner.mjs --watch",
    "test:coverage": "node scripts/test-runner.mjs --coverage",
    "lint": "tsc && eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.5",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.36.1",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "dsssp": "git+https://github.com/KinhoLeung/dsssp.git#631e8c7d28b9138dfac8a383d2d9ff9ec1a2c950",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "lightswind": "^3.1.20",
    "lucide-react": "^0.562.0",
    "motion": "^12.25.0",
    "protobufjs": "^7.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^5.0.0",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.4.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.13.14",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-react-swc": "^3.8.1",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-prettier": "^5.2.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "protobufjs-cli": "^1.1.3",
    "tailwindcss": "^3.4.17",
    "terser": "^5.46.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-svgr": "^4.3.0",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "tech.webhmi.app",
    "productName": "WebHMI",
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "icon": "public/android-chrome-512x512.png",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable"
    }
  }
}
